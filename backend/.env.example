# Copy this file to .env (never commit the real .env) and fill in real values.
# docker-compose.yml reads GITHUB_PAT from this file automatically.

# A GitHub Personal Access Token, scoped ONLY to the NPA-DASHBOARD repo,
# with just "Contents: Read and write" permission (fine-grained PAT) --
# used solely for the GitHub dual-write described in src/lib/github.js.
# Create it at github.com/settings/personal-access-tokens, as the
# mittalok-creator account. Never share this token or commit it anywhere.
GITHUB_PAT=

# Optional overrides (defaults already match the real repo):
# PORT=4100
# SESSION_TTL_HOURS=24
# ADMIN_CORS_ORIGIN=https://npadashboard.alokmittal.net
# GITHUB_REPO_OWNER=mittalok-creator
# GITHUB_REPO_NAME=NPA-DASHBOARD
# GITHUB_REPO_BRANCH=main

# Only needed once you reach M4 and uncomment the cloudflared service in
# docker-compose.yml:
# CLOUDFLARE_TUNNEL_TOKEN=
